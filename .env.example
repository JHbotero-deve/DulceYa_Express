# Variables del backend. Configúralas en Railway, nunca en el frontend.
NODE_ENV=production
PUBLIC_APP_URL=https://dulceya-express-production.up.railway.app
# Usa sandbox durante pruebas y production solo al aprobar el lanzamiento.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
# Railway PostgreSQL entrega DATABASE_URL al conectar el servicio.
DATABASE_URL=
# Opcional: disable solo para una base local sin TLS.
# PGSSLMODE=disable
